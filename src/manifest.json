{
  "name": "IPvFooBarBaz",
  "manifest_version": 3,
  "version": "2.37",
  "description": "Display the server IP address, with a realtime summary of IPv4, IPv6, ASN, hostname, and HTTPS information across all page elements.",
  "homepage_url": "https://github.com/Sohag-Dev12/ipvfoobarbaz",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icon16_transparent.png"
    },
    "default_title": "IPvFooBarBaz",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "contextMenus",
    "storage",
    "webNavigation",
    "webRequest",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
